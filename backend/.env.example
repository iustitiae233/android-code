# 服务监听端口
PORT=8787

# 手机端连接用的鉴权 token（自己设一个长随机串，手机端要填一样的）
AUTH_TOKEN=change-me-to-a-long-random-string

# Claude Code 的工作目录（默认 = 后端启动目录）
DEFAULT_CWD=C:\Users\HP\Desktop\remote

# 模型（可选，留空用 SDK 默认 / 你本地 claude 的配置）
# MODEL=claude-sonnet-4-5

# 默认权限模式：default | acceptEdits | plan | dontAsk | bypassPermissions
PERMISSION_MODE=default
